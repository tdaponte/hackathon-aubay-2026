# Configuration de l'app Streamlit Form

# Ports
STREAMLIT_PORT=8501
WEBHOOK_PORT=8502

# URLs
STREAMLIT_URL=http://localhost:8501
WEBHOOK_SERVER_URL=http://localhost:8502

# URL de l'autre app (pour les réponses)
OTHER_APP_URL=http://localhost:5000
OTHER_APP_RESPONSE_ENDPOINT=/webhook/response

# Environnement
ENVIRONMENT=development
DEBUG=True

# Notes:
# - Copie ce fichier en .env pour l'utiliser dans votre app
# - Les valeurs par défaut suffisent pour le développement local
# - En production, changez les URLs et mettez ENVIRONMENT=production
